theorem coverage_300 (k : Nat) (hk : k < 20) :
    ∃ u : RingBV, Repeats rightPos 20 16 u ∧ Differs u 300 (rightPos 300 k) := by
  have full : (1048575 : Nat).testBit k = true := by
    change (2 ^ 20 - 1 : Nat).testBit k = true
    exact (Nat.testBit_two_pow_sub_one 20 k).trans (decide_eq_true hk)
  have h := congrArg (fun bits : Nat => bits.testBit k) base_cov_300
  simp only [full, Nat.testBit_or, Bool.or_eq_true] at h
  rcases h with ((((((h0 | h1) | h2) | h3) | h4) | h5) | h6)
  · exact ⟨initRingBV Phase0.word Phase0.ph, Phase0.repeats,
      rightDiff_from_row _ _ _ 300 k (by decide) (by decide) hk
        Phase0.evolve_B_300 Phase0.evolve_Y_300 h0⟩
  · exact ⟨initRingBV Phase1.word Phase1.ph, Phase1.repeats,
      rightDiff_from_row _ _ _ 300 k (by decide) (by decide) hk
        Phase1.evolve_B_300 Phase1.evolve_Y_300 h1⟩
  · exact ⟨initRingBV Phase2.word Phase2.ph, Phase2.repeats,
      rightDiff_from_row _ _ _ 300 k (by decide) (by decide) hk
        Phase2.evolve_B_300 Phase2.evolve_Y_300 h2⟩
  · exact ⟨initRingBV Phase3.word Phase3.ph, Phase3.repeats,
      rightDiff_from_row _ _ _ 300 k (by decide) (by decide) hk
        Phase3.evolve_B_300 Phase3.evolve_Y_300 h3⟩
  · exact ⟨initRingBV Phase4.word Phase4.ph, Phase4.repeats,
      rightDiff_from_row _ _ _ 300 k (by decide) (by decide) hk
        Phase4.evolve_B_300 Phase4.evolve_Y_300 h4⟩
  · exact ⟨initRingBV Phase5.word Phase5.ph, Phase5.repeats,
      rightDiff_from_row _ _ _ 300 k (by decide) (by decide) hk
        Phase5.evolve_B_300 Phase5.evolve_Y_300 h5⟩
  · exact ⟨initRingBV Phase6.word Phase6.ph, Phase6.repeats,
      rightDiff_from_row _ _ _ 300 k (by decide) (by decide) hk
        Phase6.evolve_B_300 Phase6.evolve_Y_300 h6⟩

