def shrink (s : Nat) := ((s >>> 1) ||| (s >>> 2)) ^^^ (s &&& (s >>> 1) &&& (s >>> 2))
def ctx (p : Phase) (j : Nat) := (List.range 4).foldl (fun a (k : Nat) =>
  a + (Cm p (2450+2*j) (-350-(j:Int)-4+(k:Nat))).toNat * 2^k) 0
structure Row where
  size : Nat
  bits : Nat
  deriving Inhabited

def entry (row : Row) (i : Nat) := (row.bits >>> (36*i)) % (2^36)
def valid (p : Phase) (j : Nat) (src dst : Row) :=
  let prefixBits := ctx p j
  let want := Cm p (2452+2*j) (-352-(j:Int))
  (List.range src.size).all fun k => [0,1].all fun r =>
    let code := entry src k
    let v := shrink (shrink (prefixBits + (code%65536)*16 + r*1048576))
    let i := (code >>> (16+10*r)) % 1024
    i < dst.size && v.testBit 0 == want && (v >>> 1) % 65536 == (entry dst i)%65536

